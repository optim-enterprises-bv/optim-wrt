START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/aether-fwlogs
NFT_TABLE=inet
NFT_CHAIN=aether_fwlogs

install_nft_rule() {
	local group="$1"
	local zone="$2"

	# fw4 keeps its own nftables ruleset; adding a rule to it directly would
	# be erased on the next `fw4 reload`. The supported seam is a chain in
	# fw4's own table, hooked from the zone's input chain via an include.
	# See /usr/share/nftables.d/ -- fw4 sources those on every reload.
	#
	# The rule logs packets that fw4 has already decided to drop or reject
	# on the WAN input path. It does not change any accept/drop decision:
	# `log` is non-terminating and no verdict is attached.
	if ! command -v fw4 >/dev/null 2>&1; then
		logger -t aether-fwlogs "fw4 not present; NFLOG rule not installed. \
This package targets fw4/nftables images."
		return 1
	fi

	mkdir -p /usr/share/nftables.d/chain-post/input
	cat > "/usr/share/nftables.d/chain-post/input/10-aether-fwlogs.nft" <<NFT
# Generated by /etc/init.d/aether-fwlogs -- do not edit.
# Mirrors dropped/rejected WAN input to NFLOG group ${group} for aether-fwlogs.
# Non-terminating: this changes no firewall verdict.
iifname != "lo" meta nfproto { ipv4, ipv6 } \\
	ct state invalid,new \\
	log group ${group} prefix "aether-fwlogs: " comment "aether-fwlogs sensor (zone ${zone})"
NFT
	fw4 reload >/dev/null 2>&1 || \
		logger -t aether-fwlogs "fw4 reload failed; rule may be inactive"
}

remove_nft_rule() {
	rm -f /usr/share/nftables.d/chain-post/input/10-aether-fwlogs.nft
	command -v fw4 >/dev/null 2>&1 && fw4 reload >/dev/null 2>&1
}

start_service() {
	local enabled group capacity interval scan_ports spool_dir max_batches zone

	config_load aether-fwlogs
	config_get_bool enabled main enabled 0
	config_get group       main group       5
	config_get capacity    main capacity    4096
	config_get interval    main interval    300
	config_get scan_ports  main scan_ports  8
	config_get spool_dir   main spool_dir   /var/spool/aether-fwlogs
	config_get max_batches main max_batches 32
	config_get zone        main zone        wan

	if [ "$enabled" -eq 0 ]; then
		logger -t aether-fwlogs "disabled in /etc/config/aether-fwlogs; not starting"
		return 0
	fi

	mkdir -p "$spool_dir"
	chmod 0750 "$spool_dir"

	install_nft_rule "$group" "$zone"

	procd_open_instance
	procd_set_param command "$PROG" \
		-g "$group" \
		-c "$capacity" \
		-i "$interval" \
		-p "$scan_ports" \
		-d "$spool_dir" \
		-b "$max_batches" \
		-f
	procd_set_param respawn
	procd_set_param stderr 1
	procd_set_param file /etc/config/aether-fwlogs
	procd_close_instance
}

stop_service() {
	remove_nft_rule
}

service_triggers() {
	procd_add_reload_trigger "aether-fwlogs"
}

reload_service() {
	stop
	start
}
