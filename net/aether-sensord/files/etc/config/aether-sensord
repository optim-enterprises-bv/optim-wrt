config aether-sensord 'main'
	# Reputation enforcement is ON by default: it blocks inbound traffic
	# from addresses the controller has scored as hostile, and collects
	# nothing about the subscriber. That is the opposite trade from
	# aether-fwlogs, which is off by default because it REPORTS addresses.
	option enabled '1'

	# Signature database, shipped by the aether-appdb package. Loaded and
	# reported so the load is confirmable on a running device.
	#
	# /etc/appfilter/feature_en.cfg is still honoured via a compatibility
	# symlink, because UCI config survives sysupgrade and older devices have
	# that path written into this file.
	option db_path '/usr/share/aether/appdb.cfg'

	# Feed messages are delivered here by ac-client, which already holds the
	# device's mTLS identity. This daemon opens no network socket.
	option spool_dir '/var/spool/aether-sensord/feed'

	# Seconds between spool scans.
	option interval '30'

	# Per-element timeout. Reputation decays in the kernel as well as in the
	# scorer: an entry the controller stops refreshing ages out on its own,
	# so a controller that goes silent stops blocking rather than leaving a
	# stale set enforcing forever. Matches the scorer's 7-day half-life.
	option set_timeout '604800'

	# --- Proof of enforcement ------------------------------------------
	#
	# Seconds between canary runs; 0 disables it. On by default and NOT
	# consent-gated: the canary puts a documentation address (192.0.2.199)
	# in the live set, sends one packet at it, and requires the firewall to
	# refuse it. It collects nothing about the subscriber.
	#
	# Turning this off means nothing will ever notice that blocking has
	# stopped working. On 2026-08-22 this daemon logged "Reputation
	# enforcement is live" against nftables sets that did not exist.
	option canary_interval '3600'

	# Verdicts are written here for the uplink to ship. Deliberately not the
	# sensing spool: that one is created only when sensing is enabled, and
	# it is consent-gated because it carries attacker addresses.
	option canary_spool '/var/spool/aether-sensord/canary'

	# The identity the controller knows this device by. Leave empty unless
	# this device knows it: the uplink has one, and the daemon omits the
	# field rather than sending an empty serial that would key every
	# unidentified device to the same row.
	option serial ''

# --- Firewall-drop sensing (formerly the aether-fwlogs package) ------------
#
# SEPARATE CONSENT, NOT A SUB-OPTION OF `enabled` ABOVE.
#
# The daemons were merged; their consent was deliberately not. Everything
# above BLOCKS hostile inbound and collects nothing about the subscriber.
# This section REPORTS attacker addresses, which are personal data under
# GDPR. Enabling it is a decision with a legal basis behind it, not a
# packaging default, so it stays off even when the daemon is on.
# See ADR-019 §9 and ADR-020 decision 1.
	option sense_enabled '0'

	# NFLOG group. Must match the group in the rule installed by
	# /etc/init.d/aether-sensord. Change both or neither.
	option sense_group '5'

	# Distinct source addresses held. Bounds memory; overflow is counted
	# and reported at shutdown, never silently dropped.
	option sense_capacity '4096'

	# Distinct destination ports at or above which a source is reported as
	# a port scan rather than a blocked connection.
	#
	# MUST NOT exceed OBS_MAX_PORTS (32). Distinct ports are tracked in a
	# fixed store, so a threshold above it can never be reached and scan
	# detection would be silently disabled. The daemon refuses to start
	# sensing rather than run in that state.
	option sense_scan_ports '8'

	# Firewall zone whose input drops are logged. Must be the WAN-facing
	# zone: logging a LAN zone would report the subscriber's own network.
	# Private sources are refused and counted regardless, but the rule
	# should be correct in the first place.
	option sense_zone 'wan'

	# Batches are written here as NDJSON and shipped by ac-client, which
	# holds the device's mTLS identity. This daemon opens no network socket.
	option sense_spool '/var/spool/aether-sensord/sense'

	# Batch files retained if nothing drains them. Oldest removed first.
	option sense_max_batches '32'

# --- Application classification (nDPI) -------------------------------------
#
# SEPARATE CONSENT AGAIN, AND FOR A STRONGER REASON THAN SENSING.
#
# The sensing section above asks NFLOG for 128 bytes: headers only, so packet
# CONTENTS never enter the daemon. Classification cannot work that way -- a TLS
# ClientHello or a QUIC Initial IS payload, and identifying it means copying it
# into userspace. That is a materially different promise to the subscriber, so
# it is its own switch and defaults to off.
	# Compile /etc/config/aether-policy into host-pattern hashes and push them
	# to the aether-af module. Off means app rules parse, report as accepted,
	# and block nothing -- the module commits 0 rules.
	option app_block_enabled '1'

	option dpi_enabled '0'

	# NFLOG group for the classification mirror rule. MUST differ from
	# sense_group: one carries dropped packets, the other carries a copy of
	# allowed traffic, and mixing them would classify only what was blocked.
	option dpi_group '6'

	# Concurrent flows tracked. Bounds memory; a full table evicts the
	# least recently seen and counts it.
	option dpi_max_flows '4096'

	# How long an address block lasts, in seconds.
	#
	# Address blocks are COARSE: blocking an address blocks every name
	# behind it, which on shared CDN infrastructure reaches beyond the
	# application asked for. The timeout is what bounds that damage, so a
	# value of 0 is refused rather than meaning "forever".
	option dpi_addr_timeout '3600'

	# What to do about the flow-offload conflict.
	#
	# fw4 emits `flow offload @ft` as the FIRST statement of the forward
	# chain, ahead of every include point it offers. Once a connection is
	# established it is offloaded and later packets bypass netfilter
	# entirely -- so the TLS ClientHello, typically the fourth packet, is
	# never seen. Inspection then reports healthy and inspects nothing.
	#
	#   warn     (default) leave offloading alone. The daemon probes
	#            nftables and logs OFFLOAD CONFLICT if a flowtable exists,
	#            at start and whenever one appears later.
	#   disable  turn flow_offloading and flow_offloading_hw off so
	#            inspection works. THIS COSTS ROUTING THROUGHPUT, materially
	#            so on IPQ and filogic hardware.
	#
	# There is no setting that gives both. Open App Filter shipped
	# disable_hnat=1 for exactly this reason.
	option offload_policy 'warn'
