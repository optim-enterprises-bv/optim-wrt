config aether-sensord 'main'
	# Reputation enforcement is ON by default: it blocks inbound traffic
	# from addresses the controller has scored as hostile, and collects
	# nothing about the subscriber. That is the opposite trade from
	# aether-fwlogs, which is off by default because it REPORTS addresses.
	option enabled '1'

	# Signature database. Loaded and reported so the load is confirmable on
	# a running device; nothing classifies traffic in this build.
	option db_path '/etc/appfilter/feature_en.cfg'

	# Feed messages are delivered here by ac-client, which already holds the
	# device's mTLS identity. This daemon opens no network socket.
	option spool_dir '/var/spool/aether-sensord/feed'

	# Seconds between spool scans.
	option interval '30'

	# Per-element timeout. Reputation decays in the kernel as well as in the
	# scorer: an entry the controller stops refreshing ages out on its own,
	# so a controller that goes silent stops blocking rather than leaving a
	# stale set enforcing forever. Matches the scorer's 7-day half-life.
	option set_timeout '604800'
