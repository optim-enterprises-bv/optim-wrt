START=96
STOP=10
USE_PROCD=1

PROG=/usr/sbin/aether-sensord

install_sense_rule() {
	local group="$1"
	local zone="$2"

	# fw4 keeps its own nftables ruleset; adding a rule to it directly would
	# be erased on the next `fw4 reload`. The supported seam is a chain in
	# fw4's own table, hooked via an include -- fw4 sources those on every
	# reload.
	#
	# The rule mirrors packets fw4 has already decided about on the WAN
	# input path. It changes no verdict: `log` is non-terminating and no
	# verdict is attached.
	if ! command -v fw4 >/dev/null 2>&1; then
		logger -t aether-sensord "fw4 not present; NFLOG rule not \
installed, so sensing will see nothing. Reputation enforcement is unaffected."
		return 1
	fi

	mkdir -p /usr/share/nftables.d/chain-post/input
	cat > "/usr/share/nftables.d/chain-post/input/10-aether-sense.nft" <<NFT
# Generated by /etc/init.d/aether-sensord -- do not edit.
# Mirrors dropped/rejected WAN input to NFLOG group ${group} for sensing.
# Non-terminating: this changes no firewall verdict.
iifname != "lo" meta nfproto { ipv4, ipv6 } \\
	ct state invalid,new \\
	log group ${group} prefix "aether-sense: " comment "aether-sensord sensor (zone ${zone})"
NFT
	fw4 reload >/dev/null 2>&1 || \
		logger -t aether-sensord "fw4 reload failed; sense rule may be inactive"
}

# Flow offloading and packet inspection are mutually exclusive, and fw4 gives
# us no way to have both.
#
# fw4 emits `meta l4proto { tcp, udp } flow offload @ft` as the FIRST statement
# of the forward chain, before every include point it offers. Once a connection
# is established it is offloaded and later packets are handled at the ingress
# hook, never reaching netfilter. The TLS ClientHello is typically the fourth
# packet of a TCP flow, so it is simply never seen.
#
# This is why Open App Filter shipped disable_hnat=1 as a default. It is not
# tuning; it is the difference between inspection working and inspection being
# decorative.
#
# The choice is the operator's because it costs real throughput on IPQ and
# filogic hardware, so this never changes it silently.
apply_offload_policy() {
	local policy="$1"

	case "$policy" in
	disable)
		local cur_sw cur_hw
		cur_sw=$(uci -q get firewall.@defaults[0].flow_offloading)
		cur_hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)
		if [ "$cur_sw" = "0" ] && [ "$cur_hw" != "1" ]; then
			return 0
		fi
		uci -q set firewall.@defaults[0].flow_offloading='0'
		uci -q set firewall.@defaults[0].flow_offloading_hw='0'
		uci -q commit firewall
		logger -t aether-sensord "flow offloading DISABLED so application \
inspection can see traffic. This costs routing throughput. Set \
offload_policy='warn' in /etc/config/aether-sensord to keep offloading and \
accept that app filtering will be inert."
		command -v fw4 >/dev/null 2>&1 && fw4 reload >/dev/null 2>&1
		;;
	warn|*)
		# The daemon probes nftables directly and reports the conflict
		# if one exists. Nothing to do here beyond not hiding it.
		:
		;;
	esac
}

# Rules that actually match against the sets.
#
# Until now only the set DECLARATIONS were installed. The sets existed, the
# daemon reported "Reputation enforcement is live", and nothing referenced them
# -- so not one packet was ever dropped. The enforcement canary found this on
# its first run; `nft list table inet fw4 | grep -c @aether_` returned 0.
#
# input   : drop inbound from scored attackers.
# forward : drop both directions for LAN clients, so a hostile peer cannot
#           reach a device behind the router either.
# output  : REJECT rather than drop, for router-originated traffic. Reject is
#           what returns EPERM to a local socket, and that is what the canary
#           reads to prove enforcement is live. A silent drop would leave the
#           canary unable to distinguish "blocked" from "sent".
install_rep_rules() {
	command -v fw4 >/dev/null 2>&1 || return 1
	mkdir -p /usr/share/nftables.d/chain-pre/input \
	         /usr/share/nftables.d/chain-pre/forward \
	         /usr/share/nftables.d/chain-pre/output

	cat > /usr/share/nftables.d/chain-pre/input/10-aether-rep.nft <<NFT
# Generated by /etc/init.d/aether-sensord -- do not edit.
ip saddr @aether_rep4 counter drop comment "aether reputation"
ip6 saddr @aether_rep6 counter drop comment "aether reputation"
NFT
	cat > /usr/share/nftables.d/chain-pre/forward/11-aether-rep.nft <<NFT
# Generated by /etc/init.d/aether-sensord -- do not edit.
ip saddr @aether_rep4 counter drop comment "aether reputation in"
ip daddr @aether_rep4 counter drop comment "aether reputation out"
ip6 saddr @aether_rep6 counter drop comment "aether reputation in"
ip6 daddr @aether_rep6 counter drop comment "aether reputation out"
ip daddr @aether_app4 counter drop comment "aether app block"
ip6 daddr @aether_app6 counter drop comment "aether app block"
NFT
	cat > /usr/share/nftables.d/chain-pre/output/10-aether-rep.nft <<NFT
# Generated by /etc/init.d/aether-sensord -- do not edit.
# reject, not drop: EPERM to the local socket is what the canary reads.
ip daddr @aether_rep4 counter reject with icmp type admin-prohibited comment "aether reputation"
ip6 daddr @aether_rep6 counter reject with icmpv6 type admin-prohibited comment "aether reputation"
NFT
	fw4 reload >/dev/null 2>&1 || \
		logger -t aether-sensord "fw4 reload failed; reputation rules may be inactive"
}

remove_rep_rules() {
	rm -f /usr/share/nftables.d/chain-pre/input/10-aether-rep.nft \
	      /usr/share/nftables.d/chain-pre/forward/11-aether-rep.nft \
	      /usr/share/nftables.d/chain-pre/output/10-aether-rep.nft
	command -v fw4 >/dev/null 2>&1 && fw4 reload >/dev/null 2>&1
}

install_dpi_rule() {
	local group="$1"

	# A non-terminating copy of forwarded traffic to NFLOG, at full snaplen
	# because dissection needs the payload. `log` attaches no verdict, so
	# this changes no firewall decision.
	#
	# The forward chain, not input: this classifies what LAN devices send
	# through the router, which is the traffic policy is written about.
	if ! command -v fw4 >/dev/null 2>&1; then
		logger -t aether-sensord "fw4 not present; classification mirror \
rule not installed, so nothing will be classified."
		return 1
	fi
	mkdir -p /usr/share/nftables.d/chain-pre/forward
	cat > "/usr/share/nftables.d/chain-pre/forward/10-aether-dpi.nft" <<NFT
# Generated by /etc/init.d/aether-sensord -- do not edit.
# Mirrors forwarded traffic to NFLOG group ${group} for nDPI classification.
# Non-terminating and full-payload: this changes no firewall verdict, but it
# DOES copy packet contents into userspace. See dpi_enabled in
# /etc/config/aether-sensord.
meta l4proto { tcp, udp } log group ${group} snaplen 65535 \\
	comment "aether-sensord classification mirror"
NFT
	fw4 reload >/dev/null 2>&1 || \
		logger -t aether-sensord "fw4 reload failed; classification mirror may be inactive"
}

remove_dpi_rule() {
	rm -f /usr/share/nftables.d/chain-pre/forward/10-aether-dpi.nft
	command -v fw4 >/dev/null 2>&1 && fw4 reload >/dev/null 2>&1
}

remove_sense_rule() {
	rm -f /usr/share/nftables.d/chain-post/input/10-aether-sense.nft
	# Also clear the rule from the retired aether-fwlogs package, so an
	# upgrade does not leave a second copy feeding the same NFLOG group.
	rm -f /usr/share/nftables.d/chain-post/input/10-aether-fwlogs.nft
	command -v fw4 >/dev/null 2>&1 && fw4 reload >/dev/null 2>&1
}

start_service() {
	local enabled db_path spool_dir interval set_timeout
	local sense_enabled sense_group sense_capacity sense_scan_ports sense_zone
	local sense_spool sense_max_batches
	local dpi_enabled dpi_group dpi_max_flows dpi_addr_timeout offload_policy
	local canary_interval canary_spool serial

	config_load aether-sensord
	config_get_bool enabled main enabled 1
	config_get db_path     main db_path     /usr/share/aether/appdb.cfg
	config_get spool_dir   main spool_dir   /var/spool/aether-sensord/feed
	config_get interval    main interval    30
	config_get set_timeout main set_timeout 604800

	# Sensing is consented separately from enforcement; see the config file.
	config_get_bool sense_enabled main sense_enabled 0
	config_get sense_group      main sense_group      5
	config_get sense_capacity   main sense_capacity   4096
	config_get sense_scan_ports main sense_scan_ports 8
	config_get sense_zone       main sense_zone       wan
	config_get sense_spool      main sense_spool      /var/spool/aether-sensord/sense
	config_get sense_max_batches main sense_max_batches 32

	# Classification is consented separately again; see the config file.
	config_get_bool app_block_enabled main app_block_enabled 1
	config_get_bool dpi_enabled  main dpi_enabled  0
	config_get dpi_group         main dpi_group         6
	config_get dpi_max_flows     main dpi_max_flows     4096
	config_get dpi_addr_timeout  main dpi_addr_timeout  3600
	config_get offload_policy    main offload_policy    warn

	# Proof of enforcement. Not consent-gated: the canary sends one packet to
	# a documentation address and reports whether the firewall refused it. It
	# collects nothing about the subscriber, which is why it is on by default
	# and why its spool is separate from the sensing one.
	config_get canary_interval main canary_interval 3600
	config_get canary_spool    main canary_spool    /var/spool/aether-sensord/canary
	# The identity the controller knows this device by. Empty is fine: the
	# uplink fills it in, and the daemon omits the field rather than sending
	# an empty one.
	config_get serial          main serial          ""

	[ "$enabled" -eq 0 ] && {
		logger -t aether-sensord "disabled in /etc/config/aether-sensord"
		return 0
	}

	mkdir -p "$spool_dir"
	chmod 0750 "$spool_dir"
	install_rep_rules
	mkdir -p /usr/share/nftables.d/table-pre

	set -- "$PROG" -d "$db_path" -s "$spool_dir" -i "$interval" \
		-T "$set_timeout" -C "$canary_interval" -f

	if [ "$canary_interval" -gt 0 ]; then
		# Created here as well as in the daemon: a verdict that cannot be
		# written leaves the device looking silent to the controller, and
		# silent is its alarm state.
		mkdir -p "$canary_spool"
		chmod 0750 "$canary_spool"
		set -- "$@" -R "$canary_spool"
	fi
	[ -n "$serial" ] && set -- "$@" -I "$serial"

	# Application blocking. Without -k the daemon's push_af stays 0, the
	# compile-and-push block never runs, and app rules are structurally
	# unreachable: the module loads, the nft set and its drop rule are
	# installed, the policy parses and reports "N rules accepted", and
	# aether-af commits 0 rules. Every part worked except being asked.
	#
	# Measured on a BPI-R4 before this line existed: an accepted BLOCK rule
	# for a tag the signature database defines produced 0 hashes, and the
	# daemon's own "N host patterns compiled" line never appeared because
	# the branch that logs it was skipped.
	#
	# Default on. With no /etc/config/aether-policy there are no rules, so
	# nothing is blocked either way -- defaulting off would just be another
	# feature that ships disabled and reports success.
	if [ "$app_block_enabled" -eq 1 ]; then
		set -- "$@" -k
	fi

	if [ "$sense_enabled" -eq 1 ]; then
		install_sense_rule "$sense_group" "$sense_zone"
		mkdir -p "$sense_spool"
		chmod 0750 "$sense_spool"
		set -- "$@" -S -g "$sense_group" -c "$sense_capacity" \
			-p "$sense_scan_ports" -D "$sense_spool" \
			-b "$sense_max_batches"
	else
		# Off, or turned off since last start: take the rule down so a
		# disabled sensor is not still being fed.
		remove_sense_rule
	fi

	# Only relevant when something is actually meant to be inspecting.
	if [ "$dpi_enabled" -eq 1 ]; then
		apply_offload_policy "$offload_policy"
	fi

	if [ "$dpi_enabled" -eq 1 ]; then
		if [ "$dpi_group" = "$sense_group" ]; then
			# One group carries dropped packets and the other a copy
			# of allowed traffic. Sharing a group would classify only
			# what was already blocked, which is worse than useless:
			# it would look like classification was working.
			logger -t aether-sensord "dpi_group must differ from \
sense_group; classification NOT enabled"
		else
			install_dpi_rule "$dpi_group"
			set -- "$@" -Q -G "$dpi_group" -F "$dpi_max_flows" \
				-A "$dpi_addr_timeout"
		fi
	else
		remove_dpi_rule
	fi

	procd_open_instance
	procd_set_param command "$@"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_set_param file /etc/config/aether-sensord
	procd_close_instance
}

stop_service() {
	# The set declaration is left in place deliberately. Removing it would
	# drop every reputation block the moment the daemon stops, including
	# during a package upgrade -- failing open on a security control at
	# exactly the wrong moment. Elements age out on their own via the set
	# timeout, so a stopped daemon decays to unprotected over days rather
	# than instantly.
	#
	# The NFLOG rule is different: it exists only to feed a daemon that is
	# stopping, so leaving it would keep mirroring packets to a group with
	# no reader.
	remove_sense_rule
	remove_dpi_rule
	# Reputation rules are LEFT IN PLACE deliberately, matching the set
	# declarations: removing them would drop every block the moment the
	# daemon stops, including during a package upgrade. Elements age out on
	# their own via the set timeout.
}

service_triggers() {
	procd_add_reload_trigger "aether-sensord"
}
