#!/bin/sh /etc/rc.common

START=25
STOP=75

USE_PROCD=1

PROG=ac_client

CONFDIR=/etc/apconfig
CONFFILE=$CONFDIR/ac_client.conf

start_service() {
	procd_open_instance

	procd_set_param command $PROG -f $CONFFILE

	procd_set_param file $CONFFILE
	procd_append_param file $CONFDIR/CA/*.pem

	procd_set_param respawn

	procd_close_instance
}

reload_service() {
        procd_send_signal $PROG
}

